# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Google Cloud Configuration
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Application Settings
SECRET_KEY=your_random_secret_key_here_change_in_production
ENVIRONMENT=development
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Optional: Basic Auth for Additional Security
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change_this_password

# Optional: Allowed Email Domains for OAuth (comma-separated)
ALLOWED_EMAIL_DOMAINS=gmail.com,yourdomain.com

# Redis (optional - for production rate limiting)
REDIS_URL=redis://localhost:6379
