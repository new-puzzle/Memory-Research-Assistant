# Frontend Environment Variables Template
# Copy this file to .env and fill in your values
# 
# On Linux/Mac: cp env.template .env
# On Windows: copy env.template .env

# API Base URL (backend)
# This should point to your backend server
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth Client ID (REQUIRED)
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# 1. Create/select a project
# 2. Enable Google+ API or Google Identity
# 3. Go to "Credentials" → "Create Credentials" → "OAuth 2.0 Client ID"
# 4. Application type: "Web application"
# 5. Authorized JavaScript origins: http://localhost:5174 (or your domain)
# 6. Copy the Client ID (format: xxxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

